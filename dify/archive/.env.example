# 《午夜档案馆》配套检索后端配置示例（复制为 .env 后按需修改；不要提交真实值）

# seekdb 嵌入式实例的数据目录（必须是 Linux x86_64 可写路径）
ARCHIVE_SEEKDB_PATH=$HOME/dify-archive-data/seekdb

# 档案集合名（HNSW 向量索引 + ik 全文索引）
ARCHIVE_COLLECTION=ghost_archive

# 档案语料文件（原创怪谈设定）
# ARCHIVE_DATA_FILE=./data/scenes.json

# 监听端口，Dify HTTP 节点通过它访问（对外需经隧道或反向代理）
ARCHIVE_PORT=8011

# 访问令牌：Dify HTTP 节点的 X-Archive-Token 请求头必须与之一致；留空表示不校验
ARCHIVE_TOKEN=change-me-local-dev

# Embedding：默认离线读取 HuggingFace 缓存中的多语 MiniLM（384 维）
ARCHIVE_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ARCHIVE_EMBEDDING_DIM=384
# 设为 1 才允许联网下载模型；否则加载失败会自动降级为确定性哈希向量（玩法仍可跑通）
# ARCHIVE_EMBEDDING_ALLOW_NET=1

# PowerContext 服务地址与玩家 scope（供记忆脚本使用）
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
# ARCHIVE_PC_SCOPE_ID=scp_xxxxxxxx
